# Copy to .env and fill in a real key before running `npm run setup`.
OPENAI_API_KEY=sk-placeholder-replace-me

# Only needed if your TrueForge/MCP servers run on non-default ports/hosts.
# TRUEFORGE_URL=http://localhost:8790
# PHARMAFLOW_MCP_URL=http://localhost:8791/mcp
# PHARMAFLOW_FDA_MCP_URL=http://localhost:8792/mcp
# PORT=8787
# MCP_PORT=8791
# FDA_MCP_PORT=8792

# Set these once the repo is pushed to GitHub, so `npm run setup` can
# register the medication-continuity and shortage-analysis skills
# (they're git-backed). Point the ref at your working branch until it's
# merged to main.
# PHARMAFLOW_SKILL_REPO_URL=https://github.com/<you>/pharmaflow
# PHARMAFLOW_SKILL_REPO_REF=main
